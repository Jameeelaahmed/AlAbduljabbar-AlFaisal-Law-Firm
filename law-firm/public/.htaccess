<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Mark hashed Vite build assets so they get long-term caching (see below)
    RewriteRule ^assets/ - [E=ASSET_CACHE:1]

    # Serve existing files and directories directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # SPA fallback: route everything else to index.html
    RewriteRule ^ index.html [L]
</IfModule>

# ---- Compression: shrink text assets before sending them ----
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# ---- Caching: Vite content-hashes asset filenames on every rebuild,
#      so build assets can be cached forever and reused on every visit ----
<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable" env=ASSET_CACHE
    # The HTML shell must revalidate so it points at the new asset
    # hashes after a deploy
    <FilesMatch "^(index\.html)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
